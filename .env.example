# Copy this file to .env and fill in real values.
# .env is already excluded in .gitignore. Never commit real credentials.

# Required only if running python run_all.py --live, which connects to the
# real Razorpay Settlement Recon API using test mode keys. The default
# synthetic pipeline runs with no credentials at all. See the README setup
# section for exact steps to generate these from the Razorpay Dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
